# Sao chép thành .env. KHÔNG commit .env.

# Chạy `go run` ngoài docker: trỏ vào db của docker compose.
# Production (Render): dùng chuỗi Neon, ví dụ
#   postgres://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Trong docker compose, api luôn dùng db local (xem docker-compose.yml).
DATABASE_URL=postgres://docinsight:docinsight@localhost:5432/docinsight?sslmode=disable

# Render tự cấp PORT; local mặc định 8080.
PORT=8080

# debug | info | warn | error
LOG_LEVEL=info

# Số kết nối tối đa của pgxpool.
DB_MAX_CONNS=10

# mock | gemini. Với gemini thì LLM_API_KEY là bắt buộc.
LLM_PROVIDER=mock
LLM_API_KEY=
# Model Gemini (bỏ trống = mặc định gemini-embedding-001 / gemini-3.5-flash).
# Embedding luôn được yêu cầu 768 chiều cho khớp cột vector(768).
LLM_EMBED_MODEL=
LLM_CHAT_MODEL=

# Thư mục lưu file PDF tải lên (tương đối với thư mục chạy). Docker dùng /data/uploads.
STORAGE_DIR=storage

# Origin được gọi API từ trình duyệt (CORS), phân tách bằng dấu phẩy; "*" = mọi origin.
ALLOWED_ORIGINS=http://localhost:3000

# Cổng phía host khi chạy docker compose (tuỳ chọn).
# API_PORT=8080
# DB_PORT=5432
